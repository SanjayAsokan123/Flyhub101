import bcrypt from "bcryptjs";
import jwt from "jsonwebtoken";
import { Buyer } from "../models/Buyer.model.js";
import { createSellerNotification } from "../utils/createSellerNotification.js";
import  auth  from "../config/firebaseAdmin.js";
import { createLoginIndex, deleteLoginIndex, findLoginIndex } from "../utils/loginIndex.js";

function normalizePhone(phone) {
  if (phone.startsWith("+91")) return phone.slice(3);
  return phone;
}
async function resolveAndPersistFirebaseUid(buyer) {
  try {
    if (buyer.firebaseUid) return buyer.firebaseUid;

    if (buyer.email) {
      try {
        const rec = await auth.getUserByEmail(buyer.email);
        if (rec?.uid) buyer.firebaseUid = rec.uid;
      } catch {}
    }

    if (!buyer.firebaseUid && buyer.phoneNumber) {
      try {
        const rec = await auth.getUserByPhoneNumber("+91" + buyer.phoneNumber);
        if (rec?.uid) buyer.firebaseUid = rec.uid;
      } catch {}
    }

    if (buyer.firebaseUid) {
      await buyer.save();
      try {
        await createLoginIndex({
          uid: buyer.firebaseUid,
          email: buyer.email,
          phone: buyer.phoneNumber,
          buyerId: buyer.buyerId,
        });
      } catch (err) {
        console.warn("⚠ loginIndex error:", err.message);
      }

      return buyer.firebaseUid;
    }
    return null;
  }
  catch (err) {
    console.warn("resolve Firebase UID error:", err.message);
    return null;
  }
}

export const buyerResolvers = {
  Query: {
    buyers: async () => await Buyer.find().sort({ createdAt: -1 }),

    buyer: async (_, { buyerId }) => {
      const buyer =
        (await Buyer.findOne({ buyerId })) ||
        (await Buyer.findById(buyerId));

      if (!buyer) throw new Error("Buyer not found");
      return buyer;
    },
  },

  Mutation: {
    signupBuyer: async (_, { name, email, phone, password, firebaseUid }, { pubsub }) => {
      try {
       const hashedPassword = await bcrypt.hash(password, 10);
        const buyer = await Buyer.create({
          name,
          email,
          phoneNumber: phone,
          password: hashedPassword,
          firebaseUid,
        });

        await resolveAndPersistFirebaseUid(buyer);

        await createSellerNotification({
          sellerId: "SYSTEM",
          title: "New Buyer Registered",
          message: Buyer "${buyer.name}" created an account.,
          type: "buyer_signup",
          data: { buyerId: buyer.buyerId },
          url: /admin/buyers/${buyer.buyerId},
          pubsub,
        });

        const token = jwt.sign(
          { buyerId: buyer.buyerId, email: buyer.email },
          process.env.JWT_SECRET,
          { expiresIn: "1d" }
        );

        return {
          id: buyer.id,
          buyerId: buyer.buyerId,
          name: buyer.name,
          email: buyer.email,
          phone: buyer.phoneNumber,
          createdAt: buyer.createdAt,
          token,
        };
      } catch (err) {
        console.error("Signup error:", err);
        throw new Error(err.message);
      }
    },





    loginBuyer: async (_, { input, password }) => {
         try {
           let buyer = null;
           const normalizedInput = normalizePhone(input);

           const match = await findLoginIndex(
             input.includes("@") ? input : normalizedInput
           );
           if (match?.uid) buyer = await Buyer.findOne({ firebaseUid: match.uid });
           if (!buyer) {
             buyer =
               (await Buyer.findOne({ email: input })) ||
               (await Buyer.findOne({ phoneNumber: normalizedInput })) ||
               (await Buyer.findOne({ buyerId: input }));
           }
           if (!buyer) throw new Error("Buyer not found");
           const valid = await bcrypt.compare(password, buyer.password || "");
           if (!valid) throw new Error("Incorrect password");
           const token = jwt.sign(
             { buyerId: buyer.buyerId, email: buyer.email },
             process.env.JWT_SECRET,
             { expiresIn: "1d" }
           );
           return {
             id: buyer.id,
             buyerId: buyer.buyerId,
             name: buyer.name,
             email: buyer.email,
             phoneNumber: buyer.phoneNumber,
             createdAt: buyer.createdAt,
             token,
           };
         } catch (err) {
           throw new Error("Login failed: " + err.message);
         }
       },
       loginBuyerGoogle: async (_, { firebaseUid, email }) => {
         if (!firebaseUid) throw new Error("Firebase UID required");

         let buyer = await Buyer.findOne({ firebaseUid });
         if (!buyer) {
           buyer = await Buyer.create({
             name: "",
             email,
             firebaseUid,
             phoneNumber: "",
             password: null,
             createdAt: new Date(),
           });
         }
         const token = jwt.sign(
           { buyerId: buyer.buyerId, email: buyer.email },
           process.env.JWT_SECRET,
           { expiresIn: "1d" }
         );
         return {
           buyerId: buyer.buyerId,
           firebaseUid: buyer.firebaseUid,
           name: buyer.name,
           email: buyer.email,
           phoneNumber: buyer.phoneNumber,
           token,
         }
       },


    updateBuyer: async (_, { buyerId, name, email, phone, password }) => {
      try {
        const data = {};
        if (name) data.name = name;
        if (email) data.email = email;
        if (phone) data.phoneNumber = normalizePhone(phone);
        if (password) data.password = await bcrypt.hash(password, 10);

        const updated = await Buyer.findOneAndUpdate(
          { buyerId },
          data,
          { new: true }
        );

        if (!updated) throw new Error("Buyer not found");
        await resolveAndPersistFirebaseUid(updated);

        return updated;
      } catch (err) {
        throw new Error("Update failed: " + err.message);
      }
    },


    deleteBuyer: async (_, { buyerId }, { pubsub }) => {
      try {
        const buyer =
          (await Buyer.findOne({ buyerId })) ||
          (await Buyer.findById(buyerId));

        if (!buyer) throw new Error("Buyer not found");
        try {
          await deleteLoginIndex(
            buyer.email,
            buyer.phoneNumber,
            buyer.buyerId
          );
        } catch {}

        if (buyer.firebaseUid) {
          try {
            await auth.deleteUser(buyer.firebaseUid);
          } catch {}
        }

        await buyer.deleteOne();

        await createSellerNotification({
          sellerId: "SYSTEM",
          title: "Buyer Deleted",
          message: Buyer ${buyer.buyerId} deleted.,
          type: "buyer_deleted",
          data: { buyerId },
          pubsub,
        });

        return "Buyer deleted successfully.";
      } catch (err) {
        throw new Error("Delete failed: " + err.message);
      }
    },
  },
};