  Future<void> _loadCartCount() async {
    final prefs = await SharedPreferences.getInstance();
    final saved = prefs.getString('cart') ?? '[]';
    final cartItems = jsonDecode(saved);
    setState(() => cartCount = cartItems.length);
  }
