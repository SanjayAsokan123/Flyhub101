// EditSellerProfile.dart
import 'package:flutter/material.dart';
import 'package:graphql_flutter/graphql_flutter.dart';
import '../../config/env.dart';

class EditSellerProfile extends StatefulWidget {
  final Map<String, dynamic> sellerData;
  final String sellerId;

  const EditSellerProfile({
    super.key,
    required this.sellerData,
    required this.sellerId,
  });

  @override
  State<EditSellerProfile> createState() => _EditSellerProfileState();
}

class _EditSellerProfileState extends State<EditSellerProfile> {
  final _formKey = GlobalKey<FormState>();

  // Initialize controllers immediately
  late TextEditingController _companyNameController;
  late TextEditingController _emailController;
  late TextEditingController _addressController;
  late TextEditingController _phoneController;
  late TextEditingController _gstController;
  late TextEditingController _panController;
  late TextEditingController _bankNameController;
  late TextEditingController _accountNumberController;
  late TextEditingController _bankIFCController;
  late TextEditingController _shippingAddressController;
  late TextEditingController _pickupAddressController;

  bool _loading = false;
  final String graphqlUrl = EnvConfig.baseUrl;

  // Colors
  static const Color themeColor = Color(0xFF1A0A5B);
  static const Color textPrimary = Color(0xFF1F2937);
  static const Color textSecondary = Color(0xFF6B7280);
  static const Color borderColor = Color(0xFFE5E7EB);
  static const Color successColor = Color(0xFF10B981);
  static const Color disabledColor = Color(0xFFF3F4F6);

  @override
  void initState() {
    super.initState();
    _initializeControllers();
  }

  void _initializeControllers() {
    try {
      // Extract all values with fallbacks
      final companyName = widget.sellerData['companyName']?.toString() ?? '';
      final email = widget.sellerData['email']?.toString() ?? '';
      final address = widget.sellerData['address']?.toString() ?? '';
      final phoneNumber = widget.sellerData['phoneNumber']?.toString() ?? '';
      final gstNumber = widget.sellerData['gstNumber']?.toString() ?? '';
      // CRITICAL: Get PANnumber from sellerData, not from controller
      final panNumber = widget.sellerData['PANnumber']?.toString() ?? '';
      final bankName = widget.sellerData['bankName']?.toString() ?? '';
      final accountNumber = widget.sellerData['bankAccountNumber']?.toString() ?? '';
      final bankIFC = widget.sellerData['bankIFCnumber']?.toString() ?? '';

      // Handle list fields
      final shippingAddressData = widget.sellerData['shippingAddresses'];
      final shippingAddress = (shippingAddressData is List && shippingAddressData.isNotEmpty)
          ? shippingAddressData[0]?.toString() ?? ''
          : '';

      final pickupAddressData = widget.sellerData['pickupAddresses'];
      final pickupAddress = (pickupAddressData is List && pickupAddressData.isNotEmpty)
          ? pickupAddressData[0]?.toString() ?? ''
          : '';

      // Initialize controllers
      _companyNameController = TextEditingController(text: companyName);
      _emailController = TextEditingController(text: email);
      _addressController = TextEditingController(text: address);
      _phoneController = TextEditingController(text: phoneNumber);
      _gstController = TextEditingController(text: gstNumber);
      _panController = TextEditingController(text: panNumber);
      _bankNameController = TextEditingController(text: bankName);
      _accountNumberController = TextEditingController(text: accountNumber);
      _bankIFCController = TextEditingController(text: bankIFC);
      _shippingAddressController = TextEditingController(text: shippingAddress);
      _pickupAddressController = TextEditingController(text: pickupAddress);

    } catch (e) {
      debugPrint('Error initializing controllers: $e');
      // Fallback initialization
      _companyNameController = TextEditingController();
      _emailController = TextEditingController();
      _addressController = TextEditingController();
      _phoneController = TextEditingController();
      _gstController = TextEditingController();
      _panController = TextEditingController();
      _bankNameController = TextEditingController();
      _accountNumberController = TextEditingController();
      _bankIFCController = TextEditingController();
      _shippingAddressController = TextEditingController();
      _pickupAddressController = TextEditingController();
    }
  }

  @override
  void dispose() {
    _companyNameController.dispose();
    _emailController.dispose();
    _addressController.dispose();
    _phoneController.dispose();
    _gstController.dispose();
    _panController.dispose();
    _bankNameController.dispose();
    _accountNumberController.dispose();
    _bankIFCController.dispose();
    _shippingAddressController.dispose();
    _pickupAddressController.dispose();
    super.dispose();
  }

  Future<void> _updateProfile() async {
    if (!_formKey.currentState!.validate()) return;

    setState(() => _loading = true);

    try {
      final client = GraphQLClient(
        link: HttpLink(graphqlUrl),
        cache: GraphQLCache(),
      );

      // CORRECTED MUTATION: Using SellerInput instead of SellerProfileUpdateInput
      // SellerProfileUpdateInput requires PANnumber: String! (non-nullable)
      const String mutation = r'''
        mutation UpdateSeller($customId: String!, $input: SellerInput!) {
          updateSeller(customId: $customId, input: $input) {
            customId
            companyName
            email
            address
            phoneNumber
            gstNumber
            PANnumber
            bankName
            bankAccountNumber
            bankIFCnumber
            pickupAddresses
            shippingAddresses
          }
        }
      ''';

      // Prepare addresses as lists
      final pickupAddresses = _pickupAddressController.text.isNotEmpty
          ? [_pickupAddressController.text]
          : [];

      final shippingAddresses = _shippingAddressController.text.isNotEmpty
          ? [_shippingAddressController.text]
          : [];

      // Get original values for other fields
      final originalName = widget.sellerData['name']?.toString() ?? '';
      final originalCompanyPan = widget.sellerData['companyPan']?.toString() ?? '';
      final originalAuthorized = widget.sellerData['authorized']?.toString() ?? '';
      final originalGstNumber = widget.sellerData['gstNumber']?.toString() ?? '';

      // Build input - NOTE: Using SellerInput which allows nullable fields
      final input = {
        // Required fields that should not be empty
        'name': originalName.isNotEmpty ? originalName : '',
        'companyPan': originalCompanyPan,
        'authorized': originalAuthorized,

        // Editable fields from form
        'companyName': _companyNameController.text,
        'address': _addressController.text,
        'phoneNumber': _phoneController.text,
        'bankName': _bankNameController.text,
        'bankAccountNumber': _accountNumberController.text,
        'bankIFCnumber': _bankIFCController.text,
        'pickupAddresses': pickupAddresses,
        'shippingAddresses': shippingAddresses,

        // Read-only fields - use original values to avoid validation errors
        'email': widget.sellerData['email']?.toString() ?? '',
        'gstNumber': originalGstNumber,
        'PANnumber': widget.sellerData['PANnumber']?.toString() ?? '',
      };

      // Debug log
      debugPrint('Updating seller with PAN: ${input['PANnumber']}');
      debugPrint('Email: ${input['email']}');
      debugPrint('GST: ${input['gstNumber']}');

      final result = await client.mutate(
        MutationOptions(
          document: gql(mutation),
          variables: {
            'customId': widget.sellerId,
            'input': input,
          },
        ),
      );

      if (result.hasException) {
        debugPrint('GraphQL Error: ${result.exception}');
        if (result.exception!.graphqlErrors.isNotEmpty) {
          throw Exception(result.exception!.graphqlErrors.first.message);
        }
        throw Exception('Failed to update profile');
      }

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: const Text('Profile updated successfully!'),
            backgroundColor: successColor,
            duration: const Duration(seconds: 3),
          ),
        );

        Navigator.pop(context, true);
      }
    } catch (e) {
      debugPrint('Update error: $e');
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error: ${e.toString()}'),
            backgroundColor: Colors.red,
            duration: const Duration(seconds: 3),
          ),
        );
      }
    } finally {
      if (mounted) setState(() => _loading = false);
    }
  }

  Widget _buildTextField({
    required String label,
    required TextEditingController controller,
    required IconData icon,
    bool required = false,
    TextInputType keyboardType = TextInputType.text,
    bool readOnly = false,
    int maxLines = 1,
  }) {
    return Container(
      margin: const EdgeInsets.only(bottom: 16),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            label,
            style: TextStyle(
              fontSize: 14,
              fontWeight: FontWeight.w600,
              color: readOnly ? Colors.grey.shade600 : textPrimary,
            ),
          ),
          const SizedBox(height: 6),
          TextFormField(
            controller: controller,
            keyboardType: keyboardType,
            readOnly: readOnly,
            enabled: !readOnly,
            maxLines: maxLines,
            minLines: maxLines == 1 ? 1 : 3,
            decoration: InputDecoration(
              hintText: 'Enter $label',
              prefixIcon: Icon(
                icon,
                color: readOnly ? Colors.grey.shade500 : themeColor.withOpacity(0.7),
              ),
              border: OutlineInputBorder(
                borderRadius: BorderRadius.circular(12),
                borderSide: BorderSide(color: borderColor),
              ),
              focusedBorder: OutlineInputBorder(
                borderRadius: BorderRadius.circular(12),
                borderSide: BorderSide(
                    color: readOnly ? Colors.grey.shade400 : themeColor),
              ),
              filled: true,
              fillColor: readOnly ? disabledColor : Colors.white,
            ),
            style: TextStyle(
              color: readOnly ? Colors.grey.shade700 : textPrimary,
            ),
            validator: required && !readOnly
                ? (value) {
              if (value == null || value.trim().isEmpty) {
                return '$label is required';
              }
              return null;
            }
                : null,
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Edit Profile'),
        backgroundColor: themeColor,
        foregroundColor: Colors.white,
        elevation: 0,
      ),
      body: _loading
          ? Center(child: CircularProgressIndicator(color: themeColor))
          : SingleChildScrollView(
        padding: const EdgeInsets.all(20),
        child: Form(
          key: _formKey,
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              // Profile Image
              Center(
                child: Stack(
                  children: [
                    Container(
                      width: 120,
                      height: 120,
                      decoration: BoxDecoration(
                        shape: BoxShape.circle,
                        border: Border.all(
                          color: themeColor.withOpacity(0.3),
                          width: 3,
                        ),
                      ),
                      child: ClipOval(
                        child: Container(
                          decoration: BoxDecoration(
                            gradient: LinearGradient(
                              colors: [themeColor, const Color(0xFF2A1A6E)],
                              begin: Alignment.topLeft,
                              end: Alignment.bottomRight,
                            ),
                          ),
                          child: const Icon(
                            Icons.store_mall_directory_rounded,
                            color: Colors.white,
                            size: 50,
                          ),
                        ),
                      ),
                    ),
                    Positioned(
                      bottom: 0,
                      right: 0,
                      child: Container(
                        width: 36,
                        height: 36,
                        decoration: BoxDecoration(
                          color: themeColor,
                          shape: BoxShape.circle,
                          border: Border.all(color: Colors.white, width: 3),
                        ),
                        child: const Icon(Icons.camera_alt, color: Colors.white, size: 18),
                      ),
                    ),
                  ],
                ),
              ),
              const SizedBox(height: 24),

              // Company Information
              const Text(
                'Company Information',
                style: TextStyle(
                  fontSize: 18,
                  fontWeight: FontWeight.w700,
                  color: Color(0xFF1A0A5B),
                ),
              ),
              const SizedBox(height: 16),

              _buildTextField(
                label: 'Company Name',
                controller: _companyNameController,
                icon: Icons.business,
                required: true,
              ),
              _buildTextField(
                label: 'Email',
                controller: _emailController,
                icon: Icons.email,
                keyboardType: TextInputType.emailAddress,
                readOnly: true,
              ),
              _buildTextField(
                label: 'Phone Number',
                controller: _phoneController,
                icon: Icons.phone,
                keyboardType: TextInputType.phone,
                required: true,
              ),
              _buildTextField(
                label: 'Address',
                controller: _addressController,
                icon: Icons.location_on,
                maxLines: 3,
                required: true,
              ),
              _buildTextField(
                label: 'GST Number',
                controller: _gstController,
                icon: Icons.confirmation_number,
                readOnly: true,
              ),
              _buildTextField(
                label: 'PAN Number',
                controller: _panController,
                icon: Icons.badge,
                readOnly: true,
              ),

              const SizedBox(height: 24),
              const Divider(height: 20),
              const SizedBox(height: 24),

              // Bank Information
              const Text(
                'Bank Information',
                style: TextStyle(
                  fontSize: 18,
                  fontWeight: FontWeight.w700,
                  color: Color(0xFF1A0A5B),
                ),
              ),
              const SizedBox(height: 16),

              _buildTextField(
                label: 'Bank Name',
                controller: _bankNameController,
                icon: Icons.account_balance,
              ),
              _buildTextField(
                label: 'Account Number',
                controller: _accountNumberController,
                icon: Icons.credit_card,
                keyboardType: TextInputType.number,
              ),
              _buildTextField(
                label: 'Bank IFC Code',
                controller: _bankIFCController,
                icon: Icons.code,
              ),

              const SizedBox(height: 24),
              const Divider(height: 20),
              const SizedBox(height: 24),

              // Address Information
              const Text(
                'Shipping & Pickup Addresses',
                style: TextStyle(
                  fontSize: 18,
                  fontWeight: FontWeight.w700,
                  color: Color(0xFF1A0A5B),
                ),
              ),
              const SizedBox(height: 16),

              _buildTextField(
                label: 'Shipping Address',
                controller: _shippingAddressController,
                icon: Icons.local_shipping,
                maxLines: 3,
              ),
              _buildTextField(
                label: 'Pickup Address',
                controller: _pickupAddressController,
                icon: Icons.store,
                maxLines: 3,
              ),

              const SizedBox(height: 32),

              // Information Note
              Container(
                padding: const EdgeInsets.all(16),
                decoration: BoxDecoration(
                  color: themeColor.withOpacity(0.05),
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(color: themeColor.withOpacity(0.2)),
                ),
                child: Row(
                  children: [
                    Icon(Icons.info_outline, color: themeColor, size: 24),
                    const SizedBox(width: 12),
                    Expanded(
                      child: Text(
                        'Email, GST, and PAN are read-only fields. Contact support to update them.',
                        style: TextStyle(color: textSecondary, fontSize: 13),
                      ),
                    ),
                  ],
                ),
              ),

              const SizedBox(height: 24),

              // Save Button
              SizedBox(
                width: double.infinity,
                height: 52,
                child: ElevatedButton(
                  onPressed: _updateProfile,
                  style: ElevatedButton.styleFrom(
                    backgroundColor: themeColor,
                    foregroundColor: Colors.white,
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(12),
                    ),
                    elevation: 2,
                  ),
                  child: const Text(
                    'Save Changes',
                    style: TextStyle(fontSize: 16, fontWeight: FontWeight.w600),
                  ),
